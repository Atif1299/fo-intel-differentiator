# Copy to .env (and web/.env.local). Never commit secrets.

# Primary — embeddings + grounded answers
OPENAI_API_KEY=

# Backup answer model (optional)
GEMINI_API_KEY=

# API
APP_HOST=0.0.0.0
APP_PORT=8000
API_PUBLIC_URL=http://127.0.0.1:8000

# Next.js (also set in web/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
